.page-shell {
  position: relative;
  min-height: 100vh;
  overflow: visible;
  padding-top: 0;
  padding-right: 0;
  padding-bottom: 210rpx;
  padding-left: 0;
  transition: background 220ms cubic-bezier(0.668, 0.2, 0.338, 0.847), color 220ms cubic-bezier(0.668, 0.2, 0.338, 0.847);
}

.theme-light {
  background: #dddddd;
  color: #301a1a;
}

.theme-dark {
  background: #23262b;
  color: #f3f7fd;
}

.bg-gradient {
  position: fixed;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.gradient-blob,
.gradient-veil {
  position: absolute;
}

.gradient-blob {
  border-radius: 50%;
  filter: blur(88rpx);
  opacity: 1;
}

.blob-1 {
  top: -200rpx;
  left: -160rpx;
  width: 800rpx;
  height: 800rpx;
}

.blob-2 {
  top: 150rpx;
  right: -200rpx;
  width: 820rpx;
  height: 820rpx;
}

.blob-3 {
  bottom: -80rpx;
  left: 16rpx;
  width: 720rpx;
  height: 720rpx;
}

.gradient-veil {
  inset: 0;
}

.theme-light .blob-1 {
  background: radial-gradient(circle, rgba(154, 255, 125, 0.78) 0%, rgba(111, 134, 255, 0) 72%);
}

.theme-light .blob-2 {
  background: radial-gradient(circle, rgba(118, 210, 255, 0.72) 0%, rgba(118, 210, 255, 0) 72%);
}

.theme-light .blob-3 {
  background: radial-gradient(circle, rgba(255, 177, 213, 0.66) 0%, rgba(255, 177, 213, 0) 72%);
}

.theme-light .gradient-veil {
  background: linear-gradient(180deg, rgba(243, 246, 251, 0.12), rgba(243, 246, 251, 0.04));
}

.theme-dark .blob-1 {
  background: radial-gradient(circle, rgba(192, 255, 252, 0.72) 0%, rgba(98, 120, 255, 0) 72%);
}

.theme-dark .blob-2 {
  background: radial-gradient(circle, rgba(237, 167, 255, 0.58) 0%, rgba(69, 162, 255, 0) 72%);
}

.theme-dark .blob-3 {
  background: radial-gradient(circle, rgba(27, 31, 255, 0.5) 0%, rgba(116, 92, 255, 0) 72%);
}

.theme-dark .gradient-veil {
  background: linear-gradient(180deg, rgba(15, 18, 23, 0.08), rgba(15, 18, 23, 0.02));
}

.tab-page,
.theme-fab-bottom,
.toast-wrap,
.tabbar-wrap {
  position: relative;
  z-index: 1;
}

.app-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 18;
  overflow: hidden;
  pointer-events: none;
  isolation: isolate;
}

.app-nav-backdrop {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  backdrop-filter: blur(20rpx) saturate(145%);
  -webkit-backdrop-filter: blur(20rpx) saturate(145%);
}

.theme-light .app-nav-backdrop {
  background: rgba(255, 255, 255, 0.192);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.315);
  box-shadow: 0 10rpx 24rpx rgba(117, 137, 163, 0.08);
}

.theme-dark .app-nav-backdrop {
  background: rgba(0, 0, 0, 0.192);
  border-bottom: 2rpx solid rgba(126, 126, 126, 0.16);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.16);
}

.app-nav-title {
  position: absolute;
  z-index: 1;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 0.4rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.theme-light .app-nav-title {
  color: #1a2230;
  text-shadow: 0 4rpx 14rpx rgba(255, 255, 255, 0.22);
}

.theme-dark .app-nav-title {
  color: #f3f7fd;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.28);
}

.tab-page {
  background: transparent;
}

.content-page {
  position: relative;
  min-height: auto;
  padding: 0 24rpx 240rpx;
  box-sizing: border-box;
  z-index: 0;
}

.section-kicker.with-icon {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.section-kicker-icon {
  width: 24rpx;
  height: 24rpx;
  flex: none;
}

.section-grid {
  display: grid;
  gap: 24rpx;
}

.glass-card,
.custom-toast {
  position: relative;
  overflow: hidden;
}

.custom-toast,
.theme-toggle-orb,
.tabbar-ios,
.primary-button,
.secondary-button,
.ghost-button {
  overflow: hidden;
  backdrop-filter: blur(14rpx) saturate(136%);
  -webkit-backdrop-filter: blur(14rpx) saturate(136%);
}

.floating-card {
  transform: none;
}

.theme-light .glass-card,
.theme-light .custom-toast,
.theme-light .theme-toggle-orb,
.theme-light .tabbar-ios {
  background: rgba(255, 255, 255, 0.192);
  border: 2rpx solid rgba(255, 255, 255, 0.315);
  box-shadow: 0 10rpx 24rpx rgba(117, 137, 163, 0.08);
}

.theme-dark .glass-card,
.theme-dark .custom-toast,
.theme-dark .theme-toggle-orb,
.theme-dark .tabbar-ios {
  background: rgba(0, 0, 0, 0.192);
  border: 2rpx solid rgba(126, 126, 126, 0.16);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.16);
}

.surface-card {
  position: relative;
  overflow: hidden;
  padding: 22rpx;
  border-radius: 28rpx;
}

.theme-light .surface-card {
  background: rgba(247, 250, 255, 0.34);
  border: 1rpx solid rgba(226, 233, 242, 0.7);
}

.theme-dark .surface-card {
  background: rgba(19, 24, 32, 0.34);
  border: 1rpx solid rgba(32, 39, 51, 0.7);
}

.panel {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 36rpx;
}

.top-card {
  margin-top: 0;
}

.panel-head,
.action-row,
.todo-main,
.todo-actions {
  display: flex;
}

.panel-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  gap: 16rpx;
}

.panel-head-leading,
.panel-head-trailing {
  min-width: 0;
  display: flex;
  align-items: center;
}

.panel-head-leading {
  justify-content: flex-start;
}

.panel-head-trailing {
  justify-content: flex-end;
}

.panel-head-title {
  width: auto;
  justify-self: center;
  margin-top: 0;
  text-align: center;
  white-space: nowrap;
}

.panel-head .hero-chip,
.panel-head .live-dot {
  margin-left: 0;
}

.section-title {
  margin-top: 24rpx;
}

.theme-light .section-title {
  color: #1a2230;
}

.theme-dark .section-title {
  color: #f3f7fd;
}

.panel-head .section-title {
  margin-top: 0;
}

.sensor-grid {
  display: grid;
  gap: 16rpx;
  grid-template-columns: repeat(2, 1fr);
  margin-top: 24rpx;
}

.sensor-chart {
  margin-top: 16rpx;
  padding: 20rpx 20rpx 16rpx;
}

.sensor-chart-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.sensor-chart-title {
  flex: none;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.3;
}

.sensor-chart-legend {
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx 14rpx;
}

.sensor-chart-legend-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
}

.sensor-chart-legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex: none;
}

.sensor-chart-legend-value {
  font-weight: 800;
}

.sensor-chart-plot {
  position: relative;
  width: 100%;
  height: 150rpx;
  margin-top: 14rpx;
  overflow: hidden;
}

.sensor-chart-grid-line,
.sensor-chart-series,
.sensor-chart-segment,
.sensor-chart-point {
  position: absolute;
  pointer-events: none;
}

.sensor-chart-grid-line {
  left: 4%;
  right: 4%;
  height: 1rpx;
}

.sensor-chart-grid-line.top {
  top: 8%;
}

.sensor-chart-grid-line.middle {
  top: 50%;
}

.sensor-chart-grid-line.bottom {
  top: 92%;
}

.sensor-chart-series {
  inset: 0;
}

.sensor-chart-segment {
  height: 4rpx;
  border-radius: 999rpx;
  transform-origin: left center;
  transition:
    left 260ms cubic-bezier(0.22, 1, 0.36, 1),
    top 260ms cubic-bezier(0.22, 1, 0.36, 1),
    width 260ms cubic-bezier(0.22, 1, 0.36, 1),
    transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
}

.sensor-chart-point {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  transform: translate3d(-50%, -50%, 0);
  transition:
    left 260ms cubic-bezier(0.22, 1, 0.36, 1),
    top 260ms cubic-bezier(0.22, 1, 0.36, 1);
}

.sensor-chart-point.latest {
  width: 12rpx;
  height: 12rpx;
}

.sensor-chart-series.temperature .sensor-chart-segment,
.sensor-chart-series.temperature .sensor-chart-point {
  background: #ff707e;
}

.sensor-chart-series.humidity .sensor-chart-segment,
.sensor-chart-series.humidity .sensor-chart-point {
  background: #4ca9e5;
}

.theme-dark .sensor-chart-series.temperature .sensor-chart-segment,
.theme-dark .sensor-chart-series.temperature .sensor-chart-point {
  background: #ff7eaa;
}

.theme-dark .sensor-chart-series.humidity .sensor-chart-segment,
.theme-dark .sensor-chart-series.humidity .sensor-chart-point {
  background: #49dbff;
}

.theme-light .sensor-chart-grid-line {
  background: rgba(115, 129, 147, 0.16);
}

.theme-dark .sensor-chart-grid-line {
  background: rgba(159, 176, 194, 0.18);
}

.theme-light .sensor-chart-point {
  box-shadow: 0 0 0 3rpx rgba(247, 250, 255, 0.96);
}

.theme-dark .sensor-chart-point {
  box-shadow: 0 0 0 3rpx rgba(19, 24, 32, 0.96);
}

.sensor-chart-axis {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  min-height: 24rpx;
  margin-top: 6rpx;
  gap: 4rpx;
}

.sensor-chart-axis-label {
  min-width: 0;
  overflow: hidden;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.theme-light .sensor-chart-title {
  color: #1a2230;
}

.theme-dark .sensor-chart-title {
  color: #f3f7fd;
}

.theme-light .sensor-chart-legend-item,
.theme-light .sensor-chart-axis-label {
  color: #738193;
}

.theme-dark .sensor-chart-legend-item,
.theme-dark .sensor-chart-axis-label {
  color: #9fb0c2;
}

.sensor-chart-legend-item.temperature .sensor-chart-legend-dot {
  background: #ff707e;
  box-shadow: 0 0 18rpx rgba(255, 112, 126, 0.28);
}

.sensor-chart-legend-item.humidity .sensor-chart-legend-dot {
  background: #4ca9e5;
  box-shadow: 0 0 18rpx rgba(76, 169, 229, 0.28);
}

.theme-dark .sensor-chart-legend-item.temperature .sensor-chart-legend-dot {
  background: #ff7eaa;
  box-shadow: 0 0 18rpx rgba(255, 126, 170, 0.26);
}

.theme-dark .sensor-chart-legend-item.humidity .sensor-chart-legend-dot {
  background: #49dbff;
  box-shadow: 0 0 18rpx rgba(73, 219, 255, 0.24);
}

.hero-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.theme-light .hero-chip {
  color: #5a6777;
  background: rgba(238, 243, 249, 0.5);
  border: 1rpx solid #dce5ef;
}

.theme-dark .hero-chip {
  color: #c8d1dc;
  background: rgba(27, 33, 42, 0.52);
  border: 1rpx solid #2a323d;
}

.section-kicker {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.theme-light .section-kicker {
  color: #7c8a9a;
}

.theme-dark .section-kicker {
  color: #8592a2;
}

.live-dot,
.status-dot,
.custom-toast-dot {
  box-shadow: 0 0 28rpx rgba(127, 150, 255, 0.28);
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  flex: none;
}

.theme-light .live-dot,
.theme-light .status-dot,
.theme-light .custom-toast-dot {
  background: rgb(177, 156, 255);
  box-shadow: 0 0 14rpx rgba(177, 156, 255, 155);
}

.theme-dark .live-dot,
.theme-dark .status-dot,
.theme-dark .custom-toast-dot {
  background: rgb(177, 156, 255);
  box-shadow: 0 0 14rpx rgba(177, 156, 255, 155);
}

.theme-light .mqtt-status.online .status-dot {
  background: #4fb07b;
  box-shadow: 0 0 24rpx rgba(79, 176, 123, 0.42);
}

.theme-light .mqtt-status.offline .status-dot {
  background: #e07b93;
  box-shadow: 0 0 24rpx rgba(224, 123, 147, 0.34);
}

.theme-dark .mqtt-status.online .status-dot {
  background: #78d7a0;
  box-shadow: 0 0 24rpx rgba(120, 215, 160, 0.36);
}

.theme-dark .mqtt-status.offline .status-dot {
  background: #f0a6b7;
  box-shadow: 0 0 24rpx rgba(240, 166, 183, 0.3);
}

.sensor-card,
.todo-item-shell,
.empty-state,
.mqtt-status,
.log-item,
.log-empty {
  border-radius: 28rpx;
}

.sensor-card {
  position: relative;
  isolation: isolate;
  min-height: 238rpx;
}

.sensor-card .metric-label,
.sensor-card .sensor-value {
  position: relative;
  z-index: 1;
}

.metric-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(44rpx);
  opacity: 1;
  pointer-events: none;
}

.temp-orb {
  top: -28rpx;
  right: -20rpx;
  width: 210rpx;
  height: 210rpx;
}

.humi-orb {
  top: -28rpx;
  right: -20rpx;
  width: 220rpx;
  height: 220rpx;
}

.theme-light .temp-orb {
  background: radial-gradient(circle, rgb(255, 143, 143) 0%, rgba(255, 196, 214, 0.28) 36%, rgba(255, 143, 184, 0) 74%);
}

.theme-light .humi-orb {
  background: radial-gradient(circle, rgba(106, 197, 255, 0.62) 0%, rgba(166, 224, 255, 0.24) 38%, rgba(106, 197, 255, 0) 74%);
}

.theme-dark .temp-orb {
  background: radial-gradient(circle, rgba(255, 126, 170, 0.52) 0%, rgba(255, 126, 170, 0.2) 38%, rgba(255, 126, 170, 0) 74%);
}

.theme-dark .humi-orb {
  background: radial-gradient(circle, rgba(73, 219, 255, 0.48) 0%, rgba(98, 175, 255, 0.18) 38%, rgba(98, 175, 255, 0) 74%);
}

.metric-label-row {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.sensor-fixed-unit {
  position: absolute;
  top: 22rpx;
  right: 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.metric-label-icon {
  width: 24rpx;
  height: 24rpx;
  flex: none;
}

.metric-label,
.field-label {
  font-size: 22rpx;
  font-weight: 600;
}

.theme-light .metric-label,
.theme-light .field-label {
  color: #738193;
}

.theme-dark .metric-label,
.theme-dark .field-label {
  color: #8c98a8;
}

.metric-number,
.sensor-value {
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
  position: relative;
  overflow: visible;
}

.sensor-value {
  font-size: 56rpx;
  min-height: 64rpx;
  display: flex;
  align-items: flex-end;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

.sensor-number-track {
  display: inline-flex;
  align-items: flex-end;
  gap: 0;
  line-height: 1;
  flex: none;
  overflow: visible;
  transition: width 320ms cubic-bezier(0.22, 1, 0.36, 1);
}

.sensor-number-static {
  display: inline-flex;
  align-items: flex-end;
  line-height: 1;
  letter-spacing: 0.01em;
}

.theme-light .metric-number,
.theme-light .sensor-value,
.theme-light .message-title,
.theme-light .todo-title,
.theme-light .empty-title {
  color: #1a2230;
}

.theme-dark .metric-number,
.theme-dark .sensor-value,
.theme-dark .message-title,
.theme-dark .todo-title,
.theme-dark .empty-title {
  color: #f3f7fd;
}

.sensor-card .sensor-value {
  text-shadow: 0 0 22rpx rgba(111, 134, 255, 0.28);
}

.theme-dark .sensor-card .sensor-value {
  text-shadow: 0 0 28rpx rgba(127, 150, 255, 0.34);
}

.theme-light .sensor-fixed-unit {
  color: #738193;
}

.theme-dark .sensor-fixed-unit {
  color: #9fb0c2;
}

.sensor-digit-slot {
  position: relative;
  display: inline-flex;
  align-items: flex-end;
  justify-content: center;
  width: 0.72em;
  min-width: 0.72em;
  height: 1em;
  overflow: visible;
  will-change: transform;
}

.sensor-digit-slot.is-dot {
  width: 0.42em;
  min-width: 0.42em;
}

.sensor-digit-slot.is-empty {
  width: 0.34em;
  min-width: 0.34em;
}

.sensor-digit-char {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: block;
  text-align: center;
  line-height: 1;
  will-change: transform, opacity;
}

.sensor-digit-char.static {
  position: relative;
}

.sensor-digit-char.outgoing {
  animation: sensorDigitOut 300ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.sensor-digit-char.incoming {
  animation: sensorDigitIn 300ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.sensor-digit-char.is-empty {
  opacity: 0;
}

@keyframes sensorDigitOut {
  0% {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
  100% {
    opacity: 0;
    transform: translate3d(0, -12rpx, 0);
  }
}

@keyframes sensorDigitIn {
  0% {
    opacity: 0;
    transform: translate3d(0, 12rpx, 0);
  }
  100% {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

.input {
  background: transparent;
}

.glass-input {
  min-height: 92rpx;
  margin-top: 14rpx;
  border-radius: 24rpx;
}

.theme-light .glass-input {
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(217, 227, 238, 0.88);
  color: #18202a;
}

.theme-dark .glass-input {
  background: rgba(16, 21, 27, 0.58);
  border: 1rpx solid rgba(35, 43, 54, 0.88);
  color: #edf3fb;
}

.input-placeholder {
  color: rgba(112, 123, 137, 0.9);
}

.theme-dark .input-placeholder {
  color: rgba(142, 152, 165, 0.72);
}

.themed-button,
.themed-secondary {
  transition: transform 160ms cubic-bezier(0.668, 0.2, 0.338, 0.847), box-shadow 160ms cubic-bezier(0.668, 0.2, 0.338, 0.847), background 160ms cubic-bezier(0.668, 0.2, 0.338, 0.847);
}

.themed-button:active,
.themed-secondary:active {
  transform: scale(0.98);
}

.theme-light .themed-button {
  color: #ffffff;
  background: #6f86ff;
  border: 1rpx solid #6f86ff;
  box-shadow: 0 0 0 1rpx rgba(111, 134, 255, 0.1), 0 0 24rpx rgba(111, 134, 255, 0.34);
}

.theme-dark .themed-button {
  color: #f8fbff;
  background: #7f96ff;
  border: 1rpx solid #7f96ff;
  box-shadow: 0 0 0 1rpx rgba(127, 150, 255, 0.14), 0 0 28rpx rgba(127, 150, 255, 0.38);
}

.theme-light .themed-secondary {
  color: #4f5e70;
  background: rgba(237, 243, 250, 0.56);
  border: 1rpx solid rgba(216, 225, 236, 0.88);
}

.theme-dark .themed-secondary {
  color: #c7d1dd;
  background: rgba(23, 29, 37, 0.56);
  border: 1rpx solid rgba(39, 48, 59, 0.88);
}

.mqtt-status {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
  font-weight: 700;
  color: inherit;
  padding: 24rpx;
}

.status-copy {
  flex: 1;
  min-width: 0;
}

.status-label {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.2;
}

.status-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.theme-light .mqtt-status,
.theme-light .one-line,
.theme-light .todo-check {
  color: #506075;
}

.theme-dark .mqtt-status,
.theme-dark .one-line,
.theme-dark .todo-check {
  color: #d7e1ec;
}

.theme-light .mqtt-status.online {
  background: rgba(231, 245, 238, 0.62);
  border-color: rgba(147, 201, 171, 0.9);
  box-shadow: 0 0 24rpx rgba(93, 176, 130, 0.14);
}

.theme-light .mqtt-status.offline {
  background: rgba(255, 241, 243, 0.62);
