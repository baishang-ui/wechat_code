}

.toast-wrap {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(148rpx + env(safe-area-inset-bottom));
  height: 320rpx;
  z-index: 32;
  opacity: 0;
  transform: translateY(18rpx);
  transition: opacity 180ms cubic-bezier(0.668, 0.2, 0.338, 0.847), transform 180ms cubic-bezier(0.668, 0.2, 0.338, 0.847);
  pointer-events: none;
}

.toast-wrap.show {
  opacity: 1;
  transform: translateY(0);
}

.custom-toast {
  position: absolute;
  left: 50%;
  bottom: 0;
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  min-height: 78rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  max-width: 100%;
  will-change: transform, opacity;
  transition: opacity 280ms cubic-bezier(0.668, 0.2, 0.338, 0.847), transform 280ms cubic-bezier(0.668, 0.2, 0.338, 0.847);
}

.theme-light .custom-toast {
  box-shadow: 0 0 22rpx rgba(0, 0, 0, 0.14);
}

.theme-dark .custom-toast {
  box-shadow: 0 0 24rpx rgba(127, 150, 255, 0.18);
}

.one-line {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.section-enter {
  animation: toastItemEnter 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.page-enter {
  animation: pageFade 300ms var(--card-enter-ease) both;
}

.delay-1 {
  animation-delay: 70ms;
}

.delay-2 {
  animation-delay: 180ms;
}

.item-enter {
  animation: toastItemEnter 360ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.empty-state-enter {
  animation: toastItemEnter 320ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.todo-item.is-removing {
  max-height: 0;
  margin-bottom: 0;
  opacity: 0;
  transform: translate3d(0, 18rpx, 0) scale(0.98);
}

.todo-item.is-removing .todo-item-shell {
  opacity: 0;
  transform: translate3d(0, 18rpx, 0) scale(0.96);
}

.todo-item.is-toggling .todo-item-shell {
  transform: scale(0.988);
}

.todo-item.is-toggling .todo-check {
  transform: scale(1.04);
}

@keyframes toastItemEnter {
  0% {
    opacity: 0;
    transform: translate3d(0, 24rpx, 0) scale(0.96);
  }
  100% {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
}

@keyframes pageFade {
  from {
    opacity: 0;
    transform: translate3d(0, 12rpx, 0) scale(0.996);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}



@media (max-width: 680rpx) {
  .sensor-grid {
    grid-template-columns: 1fr;
  }

  .sensor-chart-head {
    align-items: flex-start;
    flex-direction: column;
  }

  .sensor-chart-legend {
    justify-content: flex-start;
  }

  .sensor-chart-axis-label {
    font-size: 17rpx;
  }
}
